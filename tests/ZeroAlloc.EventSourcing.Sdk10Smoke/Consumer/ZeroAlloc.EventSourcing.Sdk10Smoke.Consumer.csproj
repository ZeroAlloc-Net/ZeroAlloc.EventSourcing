<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds a consumer of the packed ZeroAlloc.EventSourcing, .Aggregates and .Generators packages with the oldest supported
    .NET SDK band, 10.0.1xx, whose compiler is Roslyn 5.0. The ZeroAlloc.EventSourcing.Generators package ships the aggregate dispatch generator in analyzers/dotnet/cs.
    A generator built against a newer Roslyn than the compiler that loads it is skipped with
    CS9057, and the build then fails because the generated code is missing.

    CS9057 is an error here as well. ZeroAlloc.Collections 1.3.2, ZeroAlloc.ValueObjects 2.4.3,
    ZeroAlloc.Serialisation 2.11.2, ZeroAlloc.Telemetry 1.14.2, ZeroAlloc.StateMachine 1.8.2 and
    ZeroAlloc.AsyncEvents 1.2.2, dependencies of the packages, also ship generators built against
    Roslyn 5.0, so no package in this build may be skipped.

    The parent folder's global.json pins the 10.0.1xx band with rollForward latestPatch, so a
    newer band cannot stand in for it. Run locally with a 10.0.1xx SDK installed:
      unset v; r=$(od -An -N4 -tx4 /dev/urandom | tr -d " ") && [ -n "$r" ] && v=9.9.9-local.sha$(git rev-parse HEAD | cut -c1-7).$(date +%s).r$r
      dotnet pack ZeroAlloc.EventSourcing.slnx -c Release -o artifacts -p:Version=${v:?no random suffix}
      cd tests/ZeroAlloc.EventSourcing.Sdk10Smoke/Consumer
      dotnet run -c Release -p:ZeroAllocEventSourcingVersion=${v:?no random suffix}
    Each step stops when the random suffix cannot be generated; give each
    concurrent run its own worktree, because runs in one checkout share obj and bin.
    Not part of the solution; the sdk10-consumer job in ci.yml runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);CS8032;CS9057</WarningsAsErrors>
  </PropertyGroup>

  <Target Name="RequireZeroAllocEventSourcingVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(ZeroAllocEventSourcingVersion)' == ''"
           Text="Pass the version of the packed packages: -p:ZeroAllocEventSourcingVersion=..." />
  </Target>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.EventSourcing" Version="[$(ZeroAllocEventSourcingVersion)]" />
    <PackageReference Include="ZeroAlloc.EventSourcing.Aggregates" Version="[$(ZeroAllocEventSourcingVersion)]" />
    <PackageReference Include="ZeroAlloc.EventSourcing.Generators" Version="[$(ZeroAllocEventSourcingVersion)]" />
  </ItemGroup>
</Project>
