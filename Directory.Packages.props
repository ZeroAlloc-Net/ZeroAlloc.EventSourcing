<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow pinning transitively-resolved package versions (used below to
         override the vulnerable native SQLite binary pulled in by Microsoft.Data.Sqlite). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="ZeroAlloc.TestHelpers" Version="1.10.0" />
    <PackageVersion Include="ZeroAlloc.Results"                  Version="1.5.1" />
    <PackageVersion Include="ZeroAlloc.Collections"              Version="1.3.2" />
    <PackageVersion Include="ZeroAlloc.AsyncEvents"              Version="1.2.2" />
    <PackageVersion Include="ZeroAlloc.ValueObjects"             Version="2.4.3" />
    <PackageVersion Include="ZeroAlloc.Serialisation"            Version="2.11.2" />
    <PackageVersion Include="ZeroAlloc.Serialisation.SystemTextJson" Version="2.11.2" />
    <PackageVersion Include="ZeroAlloc.Pipeline"                 Version="1.5.1" />
    <PackageVersion Include="ZeroAlloc.Analyzers"                Version="1.13.2" />
    <PackageVersion Include="Meziantou.Analyzer"                 Version="3.0.342" />
    <PackageVersion Include="ZeroAlloc.Telemetry"               Version="1.14.2" />
    <PackageVersion Include="ZeroAlloc.StateMachine"            Version="1.8.2" />
    <PackageVersion Include="Roslynator.Analyzers"               Version="5.0.1" />
    <PackageVersion Include="xunit"                              Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio"          Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk"             Version="18.12.0" />
    <!-- 5.0.0 is the compiler of SDK 10.0.1xx, the oldest supported SDK. The generators run in the
         consumer's compiler, and one built against a newer Roslyn is skipped there with CS9057. Test
         projects use it too. Do not raise it without raising the minimum SDK; the shared Renovate
         preset holds it below 5.1 and the roslyn-floor CI job checks the packed DLLs.
         See ZeroAlloc-Net/.github#77. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp"      Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers"   Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="AwesomeAssertions"                   Version="9.6.0" />
    <PackageVersion Include="coverlet.collector"                 Version="10.1.1" />
    <PackageVersion Include="Npgsql"                             Version="11.0.0" />
    <PackageVersion Include="NSubstitute"                        Version="6.2.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient"           Version="7.1.2" />
    <!-- CVE-2026-84008 / GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7: Microsoft.Data.SqlClient
         7.1.1, the latest release, depends on a vulnerable System.Security.Cryptography.Pkcs.
         ZeroAlloc.EventSourcing.Sql and .SqlServer reference Pkcs directly so the shipped packages
         depend on a patched version; transitive pinning covers the tests and smoke projects. Remove
         this entry and the two direct references once SqlClient depends on a patched Pkcs. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs"  Version="10.0.15" />
    <PackageVersion Include="Microsoft.Data.Sqlite"              Version="10.0.15" />
    <!-- CVE-2025-6965 / GHSA-2m69-gcr7-jv3q: Microsoft.Data.Sqlite 10.0.9 pulls
         SQLitePCLRaw.lib.e_sqlite3 2.1.11 (bundles SQLite < 3.50.2). Pin the native
         binary to 3.50.3 (SQLite 3.50.3) via transitive pinning. core/provider stay
         on 2.x (the sqlite3 C ABI is stable). Drop once Microsoft.Data.Sqlite ships
         a bumped SQLitePCLRaw. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3"         Version="3.50.3" />
    <PackageVersion Include="Testcontainers.PostgreSql"          Version="4.17.0" />
    <PackageVersion Include="Testcontainers.MsSql"               Version="4.17.0" />
    <PackageVersion Include="BenchmarkDotNet"                    Version="0.15.8" />
    <PackageVersion Include="Confluent.Kafka"                    Version="2.16.0" />
    <PackageVersion Include="Testcontainers.Kafka"               Version="4.17.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="ZeroAlloc.Mediator"                Version="5.1.5" />
    <PackageVersion Include="ZeroAlloc.Mediator.Generator"      Version="5.1.5" />
  </ItemGroup>
</Project>
